{
  "tools": [
    {
      "name": "browser_click",
      "title": "点击元素",
      "description": "Click an element located by a Playwright selector.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "selector": {
            "type": "string",
            "description": "Playwright 选择器：CSS / text=登录 / xpath=//button / role=button[name=\"OK\"]"
          },
          "button": {
            "default": "left",
            "description": "鼠标按键",
            "type": "string",
            "enum": [
              "left",
              "right",
              "middle"
            ]
          },
          "clickCount": {
            "default": 1,
            "description": "点击次数(2=双击)",
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "timeoutMs": {
            "description": "超时(毫秒)",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "selector"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "openWorldHint": true
