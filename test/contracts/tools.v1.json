    {
      "name": "browser_humanize",
      "title": "拟人化设置",
      "description": "View or update humanization settings at runtime without restarting the browser. Omit all fields to just read the current config. Humanization adds random typing delays, pauses before actions, click-position jitter and incremental scrolling; it is pacing, not proof of human interaction.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "humanize": {
            "description": "开启/关闭拟人化",
