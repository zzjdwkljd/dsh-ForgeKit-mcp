    {
      "name": "browser_headers",
      "title": "请求头管理",
      "description": "Manage request headers in three layers: browser-native defaults (fallback) < derived consistency headers (sec-ch-ua family, generated from a custom User-Agent) < custom headers. get shows every effective header with its source; set validates then replaces the custom layer (aborts on any invalid entry); clear reverts to native headers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "get",
              "set",
              "clear"
            ],
            "description": "get=查看当前请求头策略; set=设置自定义头; clear=清空自定义头(回到浏览器原生)"
          },
          "headers": {
            "description": "action=set 时的自定义请求头(键值对)，整体替换旧的自定义层",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "userAgent": {
            "description": "action=set 时可同时设置 User-Agent；尽力派生 Client Hints，不保证完整浏览器身份一致",
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
