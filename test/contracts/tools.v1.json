    {
      "name": "browser_launch",
      "title": "启动浏览器",
      "description": "Explicitly launch the browser (optional; other browser_* tools launch it lazily). Reuses a running instance unless headless/persistent/stealth mode, executable or profile differs. With persistent=true (default) local browser state is retained in the user profile; website authentication may still expire.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "headless": {
            "description": "无头模式(默认 true); false = 显示可见窗口(如扫码登录)",
            "type": "boolean"
          },
          "executablePath": {
            "description": "自定义 Chrome/Edge 路径",
            "type": "string"
          },
          "persistent": {
            "description": "持久化用户配置(默认 true)，保留 cookie/登录态/本地存储",
            "type": "boolean"
          },
          "userDataDir": {
            "description": "持久化 profile；必须在 test/login-state/ 内，默认 browser-profile；切换目录会重启浏览器",
            "type": "string"
          },
          "stealth": {
            "description": "兼容启动选项(默认 true)；不伪造页面 API，也不保证免验证",
            "type": "boolean"
          },
          "humanize": {
            "description": "拟人化模式(默认 true)：随机打字间隔、操作前停顿、点击抖动",
            "type": "boolean"
          },
          "typingDelayMinMs": {
            "description": "打字间隔下限(毫秒, 默认 40)",
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          },
          "typingDelayMaxMs": {
            "description": "打字间隔上限(毫秒, 默认 120)",
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          },
          "actionDelayMinMs": {
            "description": "操作前停顿下限(毫秒, 默认 150)",
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "actionDelayMaxMs": {
            "description": "操作前停顿上限(毫秒, 默认 600)",
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "userAgent": {
            "description": "自定义 User-Agent；尽力派生 Client Hints，并非完整浏览器身份模拟",
            "type": "string"
          },
          "headers": {
            "description": "自定义请求头(键值对)，按 custom > derived > 浏览器原生 的优先级合并；留空则用浏览器原生默认头",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
